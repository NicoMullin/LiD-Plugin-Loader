/* The version details Windows shows under the DLL's Properties > Details. */
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     LID_LOADER_VERSION_NUM
PRODUCTVERSION  LID_LOADER_VERSION_NUM
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "KSFA"
            VALUE "FileDescription",  "Let It Die Plugin Loader - DirectInput pass-through"
            VALUE "FileVersion",      LID_LOADER_VERSION
            VALUE "InternalName",     "dinput8"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "LiD Plugin Loader"
            VALUE "ProductVersion",   LID_LOADER_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
